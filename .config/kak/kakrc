# Commands
define-command rc -docstring 'edit kakrc' %{
	edit ~/.config/kak/kakrc
}
define-command file-menu -docstring 'file menu' %{
	prompt -shell-script-candidates %{ fd --type file } -menu 'file: ' %{
		edit %val{text}
	}
}
define-command buffer-menu -docstring 'buffer menu' %{
	prompt -buffer-completion -menu 'buffer: ' %{
		buffer %val{text}
	}
}
define-command prompt-grep -docstring 'grep for prompt' %{
	prompt 'grep: ' %{
		smart-grep %val{text}
	}
}
define-command zoxide -docstring 'cd with zoxide' %{
	prompt 'zoxide: ' %{
		evaluate-commands %sh{
			if directory="$(zoxide query "$kak_text")"; then
				echo "cd '$directory'; echo '$directory'"
			else
				echo "fail 'no match found: $kak_text'"
			fi
		}
	}
}
define-command prompt-make -docstring 'save and run prompt as make command' %{
	prompt -init %opt{makecmd} -shell-completion 'make: ' %{
		set-option global makecmd %val{text}
		smart-make
	}
}
define-command prompt-run -docstring 'run prompt as make command' %{
	prompt -shell-completion 'run: ' %{
		evaluate-commands -try-client %opt{toolsclient} %{
			fifo -scroll -name *make* -script %{
			    trap - INT QUIT
			    eval "$kak_text \"\$@\""
			} -- %arg{@}
			set-option buffer filetype make
			set-option buffer jump_current_line 0
		}
	}
}

# Surround
define-command surround-select -params 1 -hidden %{
	on-key -mode-name pair %{
		execute-keys "<a-a>%val{key}<a-S>"
		evaluate-commands %arg{1}
	}
}
define-command surround -docstring 'surround selection' %{
	on-key -mode-name pair %{
		evaluate-commands %sh{
			case "${kak_key}" in
			'('|')')       open='(';          close=')'          ;;
			'['|']')       open='[';          close=']'          ;;
			'{'|'}')       open='{';          close='}'          ;;
			'<lt>'|'<gt>') open='<lt>';       close='<gt>'       ;;
			*)             open="${kak_key}"; close="${kak_key}" ;;
			esac
			echo "execute-keys i${open}<esc>Ha${close}<esc>"
		}
	}
}
define-command surround-replace -docstring "replace surrounding pair" %{
	evaluate-commands %{
		execute-keys -save-regs '' Z
		surround-select %{
			on-key -mode-name new-pair %{
				evaluate-commands %sh{
					case "${kak_key}" in
					'('|')')       open='(';          close=')'          ;;
					'['|']')       open='[';          close=']'          ;;
					'{'|'}')       open='{';          close='}'          ;;
					'<lt>'|'<gt>') open='<lt>';       close='<gt>'       ;;
					*)             open="${kak_key}"; close="${kak_key}" ;;
					esac
					echo "execute-keys -save-regs '' r${open},r${close}z"
				}
			}
		}
	}
}
define-command surround-delete -docstring 'delete surrounding pair' %{
	evaluate-commands -save-regs x %{
		execute-keys -save-regs '' Z
		surround-select %{
			execute-keys -save-regs '' dz
		}
	}
}

# Jumplist
declare-option -docstring 'the active jumplist buffer' str jumplist
set-option global jumpclient client0
set-option global toolsclient tools

define-command tools -docstring 'open a new terminal for tools' %{
	new rename-client tools
}
define-command smart-grep -params .. -docstring 'grep and set jumplist' %{
	evaluate-commands -try-client %opt{toolsclient} %{
		fifo -name *grep* -script %{
			trap - INT QUIT
			[ "$#" -eq 0 ] && set -- --fixed-strings -- "$kak_selection"
			eval "$kak_opt_grepcmd \"\$@\"" 2>&1
		} -- %arg{@}
		set-option buffer filetype grep
		set-option buffer jump_current_line 0
	    set-option global jumplist *grep*
	}
}
define-command smart-make -docstring 'make and set jumplist' %{
	evaluate-commands -try-client %opt{toolsclient} %{
		fifo -scroll -name *make* -script %{
			pid_file="/run/user/$(id -u)/kak-make-$kak_session.pid"
			kill "$(cat "$pid_file" 2>/dev/null)" 2>/dev/null

			trap - INT QUIT
			eval "$kak_opt_makecmd \"\$@\" &"
			printf "%s" "$!" >"$pid_file"
			wait
		} -- %arg{@}
		set-option buffer filetype make
		set-option buffer jump_current_line 0
		set-option global jumplist *make*
	}
}
define-command smart-jump-next -docstring 'jump to next in jumplist' %{
	jump-next %opt{jumplist}
}
define-command smart-jump-previous -docstring 'jump to previous in jumplist' %{
	jump-previous %opt{jumplist}
}

# Harpoon
declare-option str-list harpoons

define-command harpoon-add -docstring 'add the current file to the list of harpoons' %{
	evaluate-commands %sh{
		eval set -- "$kak_quoted_opt_harpoons"
		for file in "$@"; do
			if [ "$file" = "$kak_bufname" ]; then
				echo "fail 'already saved'"
				exit
			fi
		done

		echo "
			set-option -add global harpoons '$kak_bufname'
			harpoon-save
			echo 'harpoon #$(($# + 1))'
		"
	}
}
define-command harpoon-open -params 1 -docstring 'go to harpoon' %{
	evaluate-commands %sh{
		index="$1"

		eval set -- "$kak_quoted_opt_harpoons"
		if [ "$#" -ge "$index" ]; then
			eval "file=\$$index"
			echo "edit '$file'"
		else
			echo "fail 'no file at index $index'"
		fi
	}
}
define-command harpoon-list -docstring 'list harpoons' %{
	evaluate-commands -save-regs dquote %{
		try %{
			set-register dquote %opt{harpoons}
			edit -scratch *harpoon*
			execute-keys -draft '%"_d<a-P>a<ret><esc>I<c-r>#: <esc>,gjd'
		} catch %{
			fail "no harpoons"
		}
	}
}
define-command harpoon-save -hidden %{
	nop %sh{
		eval set -- "$kak_quoted_opt_harpoons"
		sqlite3 "$kak_opt_database" "REPLACE INTO harpoons VALUES ('$PWD', '$(printf "%s\n" "$@")')"
	}
}
define-command harpoon-update -hidden %{
	evaluate-commands -save-regs dquote %{
		try %{
			execute-keys -draft -save-regs '' '%<a-s><a-k>^\d+:\s*\S<ret><a-;>;f:/\S<ret><a-l>y'
			set-option global harpoons %reg{dquote}
			harpoon-list
			harpoon-save
		} catch %{
			set-option global harpoons
		}
	}
}

hook global EnterDirectory .* %{
	evaluate-commands %sh{
		files="$(sqlite3 "$kak_opt_database" "SELECT files FROM harpoons WHERE pwd = '$PWD'")"
		if [ -n "$files" ]; then
			printf "set-option global harpoons "
			IFS="\n" printf "'%s' " $files
		fi
	}
}
hook global BufCreate \*harpoon\* %{
	add-highlighter buffer/harpoon-indices regex ^(\d+): 1:value
	map buffer normal <ret> ':harpoon-open %val{cursor_line}<ret>'
	map buffer user w :harpoon-update<ret>
	alias buffer write harpoon-update
	alias buffer w harpoon-update
}

# Grep write
define-command grep-write -docstring 'write the changes in a grep buffer' %{
	evaluate-commands -draft %{
		execute-keys '%<a-s>'
		evaluate-commands -itersel %{
			execute-keys 's^([^:]+):(\d+):\d+:(\N*)$<ret>'
			grep-write-impl %reg{1} %reg{2} %reg{3}
		}
	}
}
define-command grep-write-impl -params 3 -hidden %{
	evaluate-commands -no-hooks %{
		edit -existing %arg{1}
		set-register '"' %arg{3}
		execute-keys "%arg{2}gxHR"
		write
		delete-buffer
	}
}

hook global BufCreate \*grep\* %{
	map buffer user w :grep-write<ret>
	alias buffer write grep-write
	alias buffer w grep-write
}

