declare-option str database
evaluate-commands %sh{
	database="$HOME/.local/share/kakoune.db"
	sqlite3 "$database" "
		CREATE TABLE IF NOT EXISTS makecmds (
			pwd TEXT PRIMARY KEY,
			cmd TEXT
		);
		CREATE TABLE IF NOT EXISTS harpoons (
			pwd   TEXT PRIMARY KEY,
			files TEXT
		);
	"
	echo "set-option global database '$database'"
}

