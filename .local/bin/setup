#!/bin/bash
set -euo pipefail

# Packages
packages=(
	mesa-dri
	vulkan-loader

	dbus
	elogind
	polkit
	pipewire
	alsa-pipewire
	wireplumber
	xorg-minimal
	kde-plasma
	dolphin
	kdegraphics-thumbnailers
	ffmpegthumbs
	plasma-browser-integration

	fish-shell
	zoxide
	man-pages-devel
	fd
	ripgrep
	eza
	trash-cli
	wl-clipboard
	xdg-utils
	git
	difftastic
	lazygit
	lf
	unar
	kakoune
	kak-lsp
	editorconfig
	gcc

	dragon
	mpv-mpris
)
devoid_packages=(
	alacritty
	helium
	mpv
	iv

	bibata-cursor-modern-classic
	lyth-mono-term-nerd-font
)

declare -A installed
while read -r package; do
	installed["${package%-*}"]=1
done < <(xbps-query --list-manual-pkgs)
is_installed() {
	[[ -v installed["$1"] ]]
}

to_install=()
for package in "${packages[@]}"; do
	is_installed "$package" || to_install+=("$package")
done
[[ "${#to_install[@]}" > 0 ]] && sudo xbps-install -Sy "${to_install[@]}"

if [[ ! -e ~/.ssh/id_ed25519 ]]; then
	ssh-keygen -t ed25519 -f ~/.ssh/id_ed25519 -P ""

	echo "Add ~/.ssh/id_ed25519.pub to GitHub ssh keys..."
	exit
fi

[[ ! -e ~/projects/devoid ]] && git clone git@github.com:diniamo/devoid.git ~/projects/devoid
cd ~/projects/devoid

to_install=()
for package in "${devoid_packages[@]}"; do
	if ! is_installed "$package"; then
		fd -qd1 "^$package-" binpkgs || ./build "$package"
		to_install+=("$package")
	fi
done
[[ "${#to_install[@]}" > 0 ]] && sudo xbps-install -yR binpkgs "${to_install[@]}"

if ! is_installed spotify; then
	cd ~/projects/devoid/void-packages
	git reset --hard

	(
		[[ -e etc/conf ]] && source etc/conf
		[[ "${XBPS_ALLOW_RESTRICTED-}" != "yes" ]] && echo "XBPS_ALLOW_RESTRICTED=yes" > etc/conf
	)

	./xbps-src pkg spotify
	sudo xbps-install -yR hostdir/binpkgs/nonfree spotify
fi

# Dotfiles
if [[ ! -e ~/.dot ]]; then
	git clone --bare git@github.com:diniamo/dotfiles.git ~/.dot
	git --git-dir ~/.dot --work-tree ~ config status.showUntrackedFiles no
	git --git-dir ~/.dot --work-tree ~ config remote.origin.fetch "+refs/heads/*:refs/remotes/origin/*"
	git --git-dir ~/.dot --work-tree ~ checkout --force
fi

[[ ! -e ~/.local/share/fisher/functions/fisher.fish ]] && fish -c "
	curl -L https://raw.githubusercontent.com/jorgebucaran/fisher/main/functions/fisher.fish | source
	fisher update
"
[[ ! -e ~/.config/fish/conf.d ]] && ln -s ~/.local/share/fisher/conf.d ~/.config/fish/conf.d
[[ "$SHELL" != /usr/bin/fish ]] && sudo chsh -s /usr/bin/fish "$USER"

[[ ! -e ~/.config/kak/bundle/kak-bundle ]] && git clone https://codeberg.org/jdugan6240/kak-bundle.git ~/.config/kak/bundle/kak-bundle

# /etc
cd ~/.etc
while read -r relative; do
	target=~/.etc/"$relative"
	link=/etc/"$relative"

	if [[ -e "$link" ]]; then
		if [[ "$(realpath "$link")" = "$target" ]]; then
			continue
		else
			sudo rm "$link"
		fi
	else
		sudo mkdir -p "$(dirname "$link")"
	fi

	sudo ln -s "$target" "$link"
done < <(fd --type file .)

sudo mkdir -p /etc/alsa/conf.d
[[ ! -e /etc/alsa/conf.d/50-pipewire.conf         ]] && sudo ln -s /usr/share/alsa/alsa.conf.d/50-pipewire.conf         /etc/alsa/conf.d/
[[ ! -e /etc/alsa/conf.d/99-pipewire-default.conf ]] && sudo ln -s /usr/share/alsa/alsa.conf.d/99-pipewire-default.conf /etc/alsa/conf.d/

# Services
enable() {
	[[ ! -e /var/service/"$1" ]] && sudo ln -s /etc/sv/"$1" /var/service
	return 0
}
enable dbus
enable sddm
